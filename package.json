{
  "name": "woocommerce-mcp",
  "version": "0.1.0",
  "description": "MCP server for reading and managing a WooCommerce store through the WooCommerce REST API.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Naser Sadrmanesh",
    "email": "info.sadrmanesh@gmail.com",
    "url": "https://github.com/sadrmanesh"
  },
  "homepage": "https://github.com/sadrmanesh/woocommerce-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadrmanesh/woocommerce-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sadrmanesh/woocommerce-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "woocommerce",
    "wordpress",
    "ecommerce"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "woocommerce-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test --test-reporter spec test/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
