# ---------------------------------------------------------------------------
# Single store (the simplest setup)
# ---------------------------------------------------------------------------

# Store origin. Do not append /wp-json. Keep a subdirectory path if WordPress lives in one.
WOOCOMMERCE_URL=https://store.example.com

# WooCommerce > Settings > Advanced > REST API.
# Use a Read key while the store is read-only, and a Read/Write key only when writes are enabled.
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret

# Read-only is the default. Set to false to allow write tools for this store.
WOOCOMMERCE_READ_ONLY=true

# Id and label used for this store in tool calls and resource URIs.
# WOOCOMMERCE_STORE_ID=default
# WOOCOMMERCE_STORE_LABEL=Main shop

# basic (default for https), oauth1 (default for http), or query.
# WOOCOMMERCE_AUTH_MODE=basic
# WOOCOMMERCE_API_VERSION=wc/v3

# ---------------------------------------------------------------------------
# Several stores. Use WOOCOMMERCE_STORES (inline JSON) or WOOCOMMERCE_STORES_FILE,
# alone or next to the single-store variables. See docs/configuration.md.
# ---------------------------------------------------------------------------
# WOOCOMMERCE_STORES_FILE=/etc/woocommerce-mcp/stores.json
# WOOCOMMERCE_DEFAULT_STORE=default

# ---------------------------------------------------------------------------
# Write safety
# ---------------------------------------------------------------------------
# Write tools return a preview first and apply only with confirm: true.
# WOOCOMMERCE_REQUIRE_CONFIRMATION=true
# Append one JSON line per write attempt. Use a file path or "stderr".
# WOOCOMMERCE_AUDIT_LOG=./woocommerce-mcp-audit.jsonl

# ---------------------------------------------------------------------------
# Tools and privacy
# ---------------------------------------------------------------------------
# Tool names or * patterns, comma-separated. The woocommerce_ prefix is optional. Deny wins.
# WOOCOMMERCE_TOOLS_ALLOW=
# WOOCOMMERCE_TOOLS_DENY=delete_*
# Mask names, emails, phones, and street addresses in every result.
# WOOCOMMERCE_REDACT_PII=false

# ---------------------------------------------------------------------------
# Webhooks (the receiver needs MCP_TRANSPORT=http). See docs/webhooks.md.
# ---------------------------------------------------------------------------
# Secret of 16+ characters. Generate one with: openssl rand -base64 32
# WOOCOMMERCE_WEBHOOK_SECRET=
# WOOCOMMERCE_WEBHOOK_PATH=/webhooks/woocommerce
# WOOCOMMERCE_WEBHOOK_BUFFER=200
# meta (default) or shipment-tracking (needs the Shipment Tracking extension).
# WOOCOMMERCE_TRACKING_MODE=meta

# ---------------------------------------------------------------------------
# Client behaviour
# ---------------------------------------------------------------------------
# WOOCOMMERCE_TIMEOUT_MS=30000
# WOOCOMMERCE_MAX_RETRIES=2
# WOOCOMMERCE_DEFAULT_PER_PAGE=10
# WOOCOMMERCE_DEBUG=false
# WOOCOMMERCE_USER_AGENT=woocommerce-mcp/0.3.2
# Requests per second per store (0 turns the limiter off) and burst size.
# WOOCOMMERCE_RATE_LIMIT=5
# WOOCOMMERCE_RATE_BURST=10
# Exponential backoff with jitter between retries.
# WOOCOMMERCE_RETRY_BASE_MS=250
# WOOCOMMERCE_RETRY_MAX_MS=10000
# Cache read responses (0 = off). Any write clears the store's cache.
# WOOCOMMERCE_CACHE_TTL_MS=0
# WOOCOMMERCE_CACHE_MAX_ENTRIES=500

# ---------------------------------------------------------------------------
# Transport: stdio (default) or http
# ---------------------------------------------------------------------------
# MCP_TRANSPORT=stdio
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# MCP_HTTP_PATH=/mcp
# Extra Host header names and browser origins to accept (comma-separated).
# MCP_HTTP_ALLOWED_HOSTS=mcp.example.com
# MCP_HTTP_ALLOWED_ORIGINS=https://app.example.com

# Bearer authentication. Required to bind anything other than loopback.
# Full-access tokens (read and write) and read-only tokens, comma-separated, 24+ characters each.
# Generate one with: openssl rand -base64 32
# MCP_HTTP_AUTH_TOKENS=
# MCP_HTTP_AUTH_READ_TOKENS=

# OAuth 2.0 token introspection (RFC 7662) against your authorization server.
# MCP_OAUTH_ISSUER=https://auth.example.com
# MCP_OAUTH_INTROSPECTION_URL=https://auth.example.com/oauth2/introspect
# MCP_OAUTH_CLIENT_ID=woocommerce-mcp
# MCP_OAUTH_CLIENT_SECRET=
# MCP_OAUTH_RESOURCE=https://mcp.example.com/mcp
# MCP_OAUTH_REQUIRED_SCOPES=woocommerce:read

# ---------------------------------------------------------------------------
# OpenTelemetry tracing (optional packages, see docs/observability.md)
# ---------------------------------------------------------------------------
# WOOCOMMERCE_OTEL_ENABLED=false
# OTEL_SERVICE_NAME=woocommerce-mcp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
